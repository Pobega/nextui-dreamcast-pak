+static int16_t mask_dpad_if_analog_only(int16_t ret)
+{
+   if (dpad_to_analog_mode != DPAD_ANALOG_ONLY)
+      return ret;
+
+   const int16_t dpad_mask = (int16_t)(
+      (1 << RETRO_DEVICE_ID_JOYPAD_UP) |
+      (1 << RETRO_DEVICE_ID_JOYPAD_DOWN) |
+      (1 << RETRO_DEVICE_ID_JOYPAD_LEFT) |
+      (1 << RETRO_DEVICE_ID_JOYPAD_RIGHT));
+   return (int16_t)(ret & ~dpad_mask);
+}
+
+static float step_dpad_axis(float cur, int dir, u32 dt_ms)
+{
+   constexpr float kStartFrac = 0.25f;
+   if (dir == 0)
+      return 0.0f;
+   if (dpad_analog_ramp_ms <= 0)
+      return (float)dir * dpad_analog_max_frac;
+
+   float sign = (float)dir;
+   float start = std::min(kStartFrac, dpad_analog_max_frac);
+   if (cur * sign <= 0.0f)
+      return sign * start;
+
+   float step = (1.0f - kStartFrac) * ((float)dt_ms / (float)dpad_analog_ramp_ms);
+   float next = cur + sign * step;
+   if (next > dpad_analog_max_frac)
+      next = dpad_analog_max_frac;
+   else if (next < -dpad_analog_max_frac)
+      next = -dpad_analog_max_frac;
+   return next;
+}
+
+static void apply_dpad_to_analog(int16_t ret, u32 port, s16 *axis_x, s16 *axis_y)
+{
+   constexpr u32 kDefaultDtMs = 16;
+   constexpr u32 kMaxDtMs = 50;
+   constexpr float kAnalogAxisMax = 32767.0f;
+
+   DpadAnalogState &st = dpad_analog_state[port];
+   if (dpad_to_analog_mode == DPAD_ANALOG_DISABLED)
+   {
+      st.axis[0] = 0.0f;
+      st.axis[1] = 0.0f;
+      st.last_ms = 0;
+      return;
+   }
+
+   u64 now_ms = getTimeMs();
+   u32 dt_ms = (st.last_ms && now_ms > st.last_ms) ? (u32)(now_ms - st.last_ms) : kDefaultDtMs;
+   if (dt_ms > kMaxDtMs)
+      dt_ms = kMaxDtMs;
+   st.last_ms = now_ms;
+
+   int dx = ((ret >> RETRO_DEVICE_ID_JOYPAD_RIGHT) & 1) - ((ret >> RETRO_DEVICE_ID_JOYPAD_LEFT) & 1);
+   int dy = ((ret >> RETRO_DEVICE_ID_JOYPAD_DOWN)  & 1) - ((ret >> RETRO_DEVICE_ID_JOYPAD_UP)   & 1);
+
+   st.axis[0] = step_dpad_axis(st.axis[0], dx, dt_ms);
+   st.axis[1] = step_dpad_axis(st.axis[1], dy, dt_ms);
+
+   if (dx)
+      *axis_x = (s16)round(st.axis[0] * kAnalogAxisMax);
+   if (dy)
+      *axis_y = (s16)round(st.axis[1] * kAnalogAxisMax);
+}
